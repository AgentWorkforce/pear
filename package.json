{
  "name": "pear-by-agent-relay",
  "version": "1.0.0",
  "productName": "Pear by Agent Relay",
  "description": "Pair programming workspace for humans and AI agents",
  "author": "Agent Workforce Incorporated",
  "main": "./out/main/index.js",
  "bin": {
    "pear": "bin/pear.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/install-relayfile-mount.mjs --optional",
    "relayfile-mount:install": "node scripts/install-relayfile-mount.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/install-relayfile-mount.mjs --optional && electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run relayfile-mount:install && npm run build && electron-builder --mac --publish never",
    "release:mac": "npm run relayfile-mount:install && npm run build && electron-builder --mac --publish always",
    "test": "node --experimental-strip-types --no-warnings --test 'src/main/__tests__/*.test.ts'",
    "personas:refresh": "npx --yes agentworkforce install @agentworkforce/persona-autonomous-actor --overwrite"
  },
  "dependencies": {
    "@agent-relay/cloud": "^8.1.2",
    "@agent-relay/harness-driver": "^8.1.2",
    "@agent-relay/sdk": "^8.1.2",
    "@agentworkforce/deploy": "^3.0.42",
    "@relayburn/sdk": "^3.2.0",
    "@relayfile/sdk": "^0.7.23",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.4.0",
    "agent-relay": "^8.1.2",
    "agentworkforce": "^3.0.42",
    "ai-hist": "^0.2.3",
    "allotment": "^1.0.9",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-diff-view": "^3.2.1",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.2",
    "unidiff": "^1.0.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "protobufjs": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
